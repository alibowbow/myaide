<?xml version="1.0" encoding="utf-8"?>
<!-- A wide window's AlertDialog card (960dp or more): as compact as a phone's, not a slab across the screen. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetLeft="300dp" android:insetRight="300dp" android:insetTop="24dp" android:insetBottom="24dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/card"/>
        <corners android:radius="24dp"/>
    </shape>
</inset>
