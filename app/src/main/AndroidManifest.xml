<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Explicit user Settings approval only. App code confines writes to primary/들퍼레;
         old Download/들퍼레 is readable only by the verified-copy migration adapter. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- A voice call notices at once when the default network drops or returns (install-time, no prompt). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 차에서 호출어: which Bluetooth device is the car, and when it connects. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 예약 작업 on time. The user grants it in Android settings (알람 및 리마인더); without it runs come late or by a tap. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 시스템 동작: alarms and timers through the clock app's public intent (normal, no prompt). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- In-app updates hand a verified APK to Android's installer; the user confirms every install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 캘린더: the phone's calendar provider, Google Calendar included; asked at first use. Writes add
         an event the user asked for, or undo the one the app just added. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Phone control lists launchable apps to open them by name (Android 11+ package visibility).
         Read-aloud binds the device's text-to-speech engine when there is no Gemini key or no internet.
         누르고 말하기 and the no-key composer mic bind the device's speech recognition service. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- 시스템 동작: which clock, maps and settings apps handle these intents, so a missing one is reported honestly. -->
        <intent><action android:name="android.intent.action.SET_ALARM" /></intent>
        <intent><action android:name="android.intent.action.SET_TIMER" /></intent>
        <intent><action android:name="android.intent.action.SHOW_ALARMS" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="kakaomap" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="nmap" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="google.navigation" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="geo" /></intent>
        <package android:name="com.android.settings" />
    </queries>
    <application android:name=".GyeotApp" android:label="@string/app_name" android:theme="@style/AppTheme"
        android:icon="@mipmap/ic_launcher" android:allowBackup="false" android:fullBackupContent="@xml/backup_rules" android:dataExtractionRules="@xml/data_extraction_rules" android:usesCleartextTraffic="false"
        android:supportsRtl="true">
        <activity android:name=".StorageSetupActivity" android:exported="false" />
        <activity android:name=".FileExplorerActivity" android:exported="false" />
        <!-- 페이지: documents made in the 작업창 and the main chat, by category. -->
        <activity android:name=".PagesActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".SearchActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".BoardActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".BrowserActivity" android:exported="false" android:launchMode="singleTop" android:windowSoftInputMode="adjustResize" />
        <!-- Explicit navigation, shortcut and sign-in intents keep a single main window. -->
        <activity android:name=".MainChatActivity" android:exported="true" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:alwaysRetainTaskState="true" android:windowSoftInputMode="adjustResize">
            <!-- "Back to 곁" link on the ChatGPT sign-in completion page; it only opens settings. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gyeot" android:host="openai-done" />
            </intent-filter>
        </activity>
        <!-- A plain icon tap can bring the live board task forward without clearing its activity stack. -->
        <activity android:name=".LauncherActivity" android:exported="true" android:taskAffinity=""
            android:excludeFromRecents="true" android:noHistory="true" android:theme="@style/QuickTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press 곁's icon: "바로 대화". -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <!-- Voice-only entry for the existing app shortcut, quick settings tile, edge button and assist gesture.
             It deliberately has no launcher filter: the app drawer shows only 들퍼레. Keep this component stable for
             existing user-pinned shortcuts; removing a launcher entry must not delete app or conversation data. -->
        <activity android:name=".QuickVoiceActivity" android:exported="true" android:label="@string/quick_voice_label"
            android:icon="@mipmap/ic_quick_launcher" android:theme="@style/QuickTheme" android:taskAffinity=""
            android:excludeFromRecents="true" android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- 공유로 받기: text or an address another app shares. It shows one sheet over that app and sends nothing by itself. -->
        <activity android:name=".ShareActivity" android:exported="true" android:label="@string/app_name" android:theme="@style/QuickTheme"
            android:taskAffinity="" android:excludeFromRecents="true" android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <service android:name=".BoardJobService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name=".MainBrowserService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name=".BrowserTaskService" android:exported="false" android:foregroundServiceType="dataSync" />
        <!-- 예약 작업: only this app's own alarm reaches it (no intent filter, not exported, no boot listener). -->
        <receiver android:name=".WorkScheduleAlarm" android:exported="false" />
        <!-- 차에서 호출어: started from the settings while the app is in front, so Android lets it use the microphone later. -->
        <service android:name=".WakeWordService" android:exported="false" android:foregroundServiceType="microphone" />
        <service android:name=".AssistantService" android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback|dataSync" android:stopWithTask="false" />
        <provider android:name=".ManagedDocumentsProvider" android:authorities="dev.jun.gyeot.shared-documents"
            android:exported="true" android:permission="android.permission.MANAGE_DOCUMENTS" android:grantUriPermissions="true">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
        <!-- The verified update APK, lent read-only to Android's package installer for one install. -->
        <provider android:name=".UpdateFiles" android:authorities="dev.jun.gyeot.updates" android:exported="false" android:grantUriPermissions="true" />
        <!-- Quick settings tile "곁": only the system UI can bind it; a tap goes through QuickVoiceActivity. -->
        <service android:name=".QuickTile" android:exported="true" android:label="@string/quick_tile_label"
            android:icon="@drawable/ic_mic" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <!-- Phone control: Android binds it only after the user turns it on in Accessibility settings, and it acts only while
             the user has armed it in 곁. -->
        <service android:name=".PhoneService" android:exported="true" android:label="@string/phone_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/phone_service" />
        </service>
        <provider android:name=".BrowserArtifactFiles" android:authorities="dev.jun.gyeot.browser-artifacts" android:exported="false" android:grantUriPermissions="true" />
        <!-- 페이지's 공유: one page's file, read only, for the app the user shares it with. -->
        <provider android:name=".PageFiles" android:authorities="dev.jun.gyeot.pages" android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>


